<style>
:root{--forest:#164d39;--deep:#103b2c;--lime:#d5f48b;--ink:#18231e;--muted:#64736b;--paper:#f6f8f4;--line:#e2e8e1}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.wrap{width:min(1100px,calc(100% - 36px));margin:auto}header{position:sticky;top:0;z-index:5;background:#ffffffeb;border-bottom:1px solid var(--line);backdrop-filter:blur(10px)}.nav{height:72px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{font-weight:850;letter-spacing:-.4px}.mark{display:inline-grid;place-items:center;margin-right:9px;width:34px;height:34px;border-radius:10px;background:var(--forest);color:white;font-size:12px}.links{display:flex;gap:24px;color:var(--muted);font-size:14px}.btn{display:inline-flex;justify-content:center;align-items:center;padding:11px 17px;border:0;border-radius:10px;background:var(--forest);color:white;font-weight:750;cursor:pointer}.btn:hover{background:var(--deep)}.hero{margin:26px auto 0;padding:65px 7%;border-radius:24px;background:var(--forest);color:#fff}.eyebrow{color:var(--lime);font-size:12px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase}.hero h1{max-width:720px;margin:17px 0;font-size:clamp(42px,7vw,72px);line-height:1.03;letter-spacing:-3px}.hero p{max-width:610px;color:#d8e5dc;font-size:18px}.actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:26px}.btn.lime{background:var(--lime);color:var(--deep)}.btn.outline{background:transparent;border:1px solid #ffffff70}.section{padding:58px 0}.heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:20px}.heading h2{margin:0;font-size:30px;letter-spacing:-1px}.heading p{margin:6px 0 0;color:var(--muted)}.search{display:flex;gap:8px;width:min(460px,100%)}input,select,textarea{width:100%;padding:12px;border:1px solid #d5ded5;border-radius:10px;background:white;color:var(--ink);outline:none}input:focus,select:focus,textarea:focus{border-color:#548569;box-shadow:0 0 0 3px #164d3918}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.chip{padding:7px 12px;border:1px solid var(--line);border-radius:99px;background:white;color:#46554c;cursor:pointer;font-size:13px}.chip.active,.chip:hover{background:var(--forest);color:white;border-color:var(--forest)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{padding:19px;border:1px solid var(--line);border-radius:16px;background:white}.tag{display:inline-block;padding:4px 9px;border-radius:99px;background:#edf4e8;color:var(--forest);font-size:11px;font-weight:750}.card h3{margin:13px 0 6px;font-size:18px}.card p{margin:0;color:var(--muted);font-size:14px;white-space:pre-wrap;overflow-wrap:anywhere}.meta{margin-top:12px;color:#849087;font-size:12px}.empty{grid-column:1/-1;padding:30px;border:1px dashed #cbd6cb;border-radius:15px;text-align:center;color:var(--muted)}.guides{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.guide{display:flex;flex-direction:column;padding:21px;border:1px solid var(--line);border-radius:16px;background:#fff}.guide-meta{display:flex;align-items:center;justify-content:space-between;gap:8px}.region{color:var(--muted);font-size:11px;font-weight:750;text-transform:uppercase;letter-spacing:.5px}.guide h3{margin:16px 0 8px;font-size:19px;line-height:1.25}.guide p{margin:0 0 12px;color:var(--muted);font-size:14px}.guide ul{margin:0 0 16px;padding-left:19px;color:var(--ink);font-size:14px}.guide li{margin:5px 0}.source{margin-top:auto;padding-top:12px;border-top:1px solid var(--line);color:var(--forest);font-size:13px;font-weight:750}.editorial{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}.editorial article{padding:17px;border-radius:14px;background:#fff;border:1px solid var(--line)}.editorial h3{margin:0 0 6px;font-size:15px}.editorial p{margin:0;color:var(--muted);font-size:13px}@media(max-width:760px){.guides,.editorial{grid-template-columns:1fr}}.callout{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:25px;border-radius:16px;background:#e8f0e5}.callout h2{margin:0}.callout p{margin:4px 0;color:var(--muted)}.share{scroll-margin-top:85px}.sharegrid{display:grid;grid-template-columns:.8fr 1.2fr;gap:32px}.sharegrid h2{font-size:38px;line-height:1.08;letter-spacing:-1.5px;margin:10px 0}.muted{color:var(--muted)}.note,.form{padding:23px;border:1px solid var(--line);border-radius:16px;background:white}.note{margin-top:18px;color:var(--muted);font-size:13px}.form h3{margin:0;font-size:21px}.form>p{margin:4px 0;color:var(--muted);font-size:14px}label{display:block;margin:16px 0 6px;font-weight:700;font-size:14px}textarea{min-height:145px;resize:vertical}.hint{font-size:12px;color:var(--muted);margin:4px 0}.consent{display:flex;gap:9px;align-items:flex-start;color:var(--muted);font-size:13px;margin:15px 0}.consent input{width:17px;margin:2px 0;accent-color:var(--forest)}.form button{width:100%}.message{min-height:23px;font-size:14px;font-weight:700}.good{color:var(--forest)}.bad{color:#a52222}.hidden{display:none!important}footer{padding:22px 0;border-top:1px solid var(--line);color:var(--muted);font-size:13px}.foot{display:flex;justify-content:space-between;gap:12px}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:760px){.grid{grid-template-columns:repeat(2,1fr)}.heading{align-items:stretch;flex-direction:column}.search{width:100%}.sharegrid{grid-template-columns:1fr;gap:18px}}@media(max-width:560px){.wrap{width:calc(100% - 28px)}.nav{height:64px}.links{display:none}.nav>.btn{font-size:13px;padding:9px}.hero{margin-top:14px;padding:42px 22px}.hero h1{letter-spacing:-2px}.hero p{font-size:16px}.section{padding:43px 0}.grid{grid-template-columns:1fr}.callout,.foot{align-items:flex-start;flex-direction:column}.heading h2{font-size:26px}}
</style>
</head>
<body>
<header><div class="wrap nav"><a class="brand" href="#home"><span class="mark">UR</span>Unlimited Reference</a><nav class="links"><a href="#experiences">Explore</a><a href="#guides">Guides</a><a href="#about">About</a></nav><a class="btn" href="#share">Share an experience ↗</a></div></header>
<main class="wrap">
<section class="hero" id="home"><span class="eyebrow">Knowledge, passed forward</span><h1>Learn from the things people have lived.</h1><p>Honest experiences. Useful lessons. A growing reference for the questions you wish you had asked sooner.</p><div class="actions"><a class="btn lime" href="#experiences">Explore experiences ↓</a><a class="btn outline" href="#share">Share what you know</a></div></section>
<section class="section" id="experiences"><div class="heading"><div><h2>Explore the reference</h2><p>Search approved community experiences or browse by topic.</p></div><form class="search" id="searchForm" role="search"><label class="sr" for="searchInput">Search experiences</label><input id="searchInput" type="search" placeholder="Search experiences…"><button class="btn">Search</button></form></div><div class="filters" id="filters"></div><div class="grid" id="list" aria-live="polite"></div></section>
<section class="section" id="guides">
  <div class="heading"><div><h2>Featured reference guides</h2><p>Practical starting points with links to authoritative sources.</p></div></div>
  <div class="guides">
    <article class="guide"><div class="guide-meta"><span class="tag">Cars & Mechanics</span><span class="region">UK guidance</span></div><h3>How to read a vehicle’s MOT history</h3><p>The official record can show MOT pass or fail results, recorded mileage and when the next test is due. Review advisories and repeated faults as part of your checks.</p><ul><li>Compare mileage across test dates.</li><li>Read advisories as well as failures.</li><li>An MOT is not a full mechanical inspection: it does not cover the engine, clutch or gearbox.</li></ul><a class="source" href="https://www.gov.uk/check-mot-history" target="_blank" rel="noopener noreferrer">Source: GOV.UK MOT history ↗</a></article>
    <article class="guide"><div class="guide-meta"><span class="tag">Technology</span><span class="region">Security basics</span></div><h3>Make passwords easier to manage</h3><p>The UK National Cyber Security Centre recommends using three random words as one memorable approach. A password manager is another way to create and remember strong, separate passwords.</p><ul><li>Choose words that are random and not personal details.</li><li>Avoid reusing the same password across important accounts.</li><li>Use a password manager if it works for you.</li></ul><a class="source" href="https://www.ncsc.gov.uk/collection/top-tips-for-staying-secure-online/three-random-words" target="_blank" rel="noopener noreferrer">Source: NCSC password advice ↗</a></article>
    <article class="guide"><div class="guide-meta"><span class="tag">Work & Careers</span><span class="region">UK guidance</span></div><h3>Prepare for a job interview</h3><p>Preparation helps you choose relevant examples and understand what the role requires. The UK National Careers Service suggests researching the employer and reviewing the job description.</p><ul><li>Check the interview format, time and location.</li><li>Prepare examples that show skills from the job description.</li><li>Practise answers and prepare questions of your own.</li></ul><a class="source" href="https://nationalcareers.service.gov.uk/careers-advice/interview-advice/interview-advice" target="_blank" rel="noopener noreferrer">Source: National Careers Service ↗</a></article>
  </div>
  <div class="editorial" aria-label="How this reference works"><article><h3>Sources are visible</h3><p>Starter guides link to their original sources. Check the source for full details and updates.</p></article><article><h3>Guidance has a scope</h3><p>Some information is specific to the UK. Check local rules and current official guidance.</p></article><article><h3>Experiences are personal</h3><p>Community stories describe individual experiences. They may not apply to everyone or replace official advice.</p></article></div>
</section>
<section class="section" id="about" style="padding-top:0"><div class="callout"><div><h2>One lesson could save someone hours.</h2><p>Share what you learned and help the next person.</p></div><a class="btn" href="#share">Write an experience →</a></div></section>
<section class="section share hidden" id="share"><a href="#home" class="muted">← Back to homepage</a><div class="sharegrid" style="margin-top:16px"><div><span class="eyebrow" style="color:var(--forest)">Pass it forward</span><h2>Your experience can help someone.</h2><p class="muted">Tell the story: what happened, what you learned, and what you would tell someone facing the same thing.</p><div class="note"><strong>About saving</strong><br>Submissions are saved to the shared database for review before they appear publicly.</div></div><form class="form" id="experienceForm"><h3>Share an experience</h3><p>Fields marked * are required.</p><label for="title">Experience title *</label><input id="title" name="title" maxlength="100" placeholder="What did you learn?" required><label for="category">Category *</label><select id="category" name="category" required><option value="">Choose a category</option><option>Cars & Mechanics</option><option>Work & Careers</option><option>Education</option><option>Life</option><option>Skills</option><option>Technology</option><option>Living</option><option>Other</option></select><label for="story">Your experience *</label><textarea id="story" name="story" maxlength="5000" placeholder="What happened? What did you learn? What would you recommend?" required></textarea><p class="hint"><span id="count">0</span>/5000 characters</p><label class="consent"><input type="checkbox" id="consent" required><span>I confirm this is my experience to share and it does not contain someone else's private information.</span></label><button class="btn">Save experience</button><p id="message" class="message" role="status" aria-live="polite"></p></form></div></section>
</main><footer><div class="wrap foot"><span>© 2026 Unlimited Reference</span><span>Real experience. Useful knowledge.</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function(){
"use strict";
var SUPABASE_URL="https://pczfoiywhkurnmxymmrn.supabase.co";
var SUPABASE_PUBLISHABLE_KEY="sb_publishable_MIX_cNQPgIxDjMUlJ3wJyg_qyJJi8UQ";
var configured=SUPABASE_URL.indexOf("https://")===0&&SUPABASE_PUBLISHABLE_KEY.indexOf("PASTE_")!==0;
var db=configured?window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY):null;
var cats=["All","Cars & Mechanics","Work & Careers","Education","Life","Skills","Technology","Living","Other"], chosen="All", query="";
var list=document.getElementById("list"), filters=document.getElementById("filters"), input=document.getElementById("searchInput");
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function renderFilters(){filters.innerHTML=cats.map(function(c){return '<button type="button" class="chip'+(c===chosen?' active':'')+'" data-cat="'+esc(c)+'" aria-pressed="'+(c===chosen)+'">'+esc(c)+'</button>'}).join("")}
async function render(){
 if(!db){list.innerHTML='<div class="empty"><strong>Connect the database to load shared experiences.</strong><br>Set your Supabase project URL and publishable key in index.html after setting up the database.</div>';return}
 list.innerHTML='<div class="empty">Loading approved experiences…</div>';
 var result=await db.from("experiences").select("id,title,category,story,created_at").eq("status","approved").order("created_at",{ascending:false}).limit(100);
 if(result.error){list.innerHTML='<div class="empty"><strong>Could not load experiences.</strong><br>'+esc(result.error.message)+'</div>';return}
 var q=query.toLowerCase(), items=(result.data||[]).filter(function(x){return (chosen==="All"||x.category===chosen)&&(!q||(x.title+" "+x.story+" "+x.category).toLowerCase().indexOf(q)>=0)});
 if(!items.length){list.innerHTML='<div class="empty"><strong>'+(q?'No matching experiences found.':'No approved experiences yet.')+'</strong><br>'+(q?'Try a different search or category.':'Be the first to share one. Submissions appear after review.')+'</div>';return}
 list.innerHTML=items.map(function(x){return '<article class="card"><span class="tag">'+esc(x.category)+'</span><h3>'+esc(x.title)+'</h3><p>'+esc(x.story)+'</p><div class="meta">Shared '+esc(x.created_at?new Date(x.created_at).toLocaleDateString():"recently")+'</div></article>'}).join("")
}
filters.addEventListener("click",function(e){var b=e.target.closest("[data-cat]");if(!b)return;chosen=b.dataset.cat;renderFilters();render()});
document.getElementById("searchForm").addEventListener("submit",function(e){e.preventDefault();query=input.value.trim();render();document.getElementById("experiences").scrollIntoView({behavior:"smooth"})});
input.addEventListener("input",function(){if(!input.value.trim()){query="";render()}});
document.getElementById("story").addEventListener("input",function(e){document.getElementById("count").textContent=e.target.value.length});
document.getElementById("experienceForm").addEventListener("submit",async function(e){
 e.preventDefault();var f=e.currentTarget,m=document.getElementById("message");
 if(!db){m.className="message bad";m.textContent="The shared database is not connected yet. Add your Supabase URL and publishable key first.";return}
 m.className="message";m.textContent="Submitting…";
 var result=await db.from("experiences").insert({title:f.elements.title.value.trim(),category:f.elements.category.value,story:f.elements.story.value.trim(),status:"pending"});
 if(result.error){m.className="message bad";m.textContent="Could not submit: "+result.error.message;return}
 f.reset();document.getElementById("count").textContent="0";m.className="message good";m.textContent="Submitted for review. It will appear on Explore after approval."
});
function showRoute(){var sharing=location.hash==="#share";document.getElementById("share").classList.toggle("hidden",!sharing);if(sharing)setTimeout(function(){document.getElementById("share").scrollIntoView({behavior:"smooth"})},0)}
window.addEventListener("hashchange",showRoute);showRoute();renderFilters();render()
})();
</script>
</body>
</html>




